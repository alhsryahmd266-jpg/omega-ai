<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="GameVision" android:textColor="@color/textMain" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:layout_marginBottom="24dp"
        android:text="بوت اختبار محلي بيلعب بدالك — بدون أي اتصال بالإنترنت وبدون أي تعديل في اللعبة نفسها"
        android:textColor="@color/textDim" android:textSize="13sp" />

    <TextView android:id="@+id/stepOverlayTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="1) إظهار الزرار فوق الشاشات التانية" android:textColor="@color/textMain" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/stepOverlayStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:layout_marginBottom="8dp" android:textColor="@color/textDim" android:textSize="12sp" />
    <Button android:id="@+id/btnOverlayPermission" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="20dp" android:text="افتح إعدادات الظهور فوق التطبيقات" />

    <TextView android:id="@+id/stepAccessTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="2) تفعيل خدمة الوصول (لالتقاط الشاشة واللمس)" android:textColor="@color/textMain" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/stepAccessStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:layout_marginBottom="8dp" android:textColor="@color/textDim" android:textSize="12sp" />
    <Button android:id="@+id/btnAccessibilitySettings" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="28dp" android:text="افتح إعدادات خدمة الوصول" />

    <Button android:id="@+id/btnLaunchOverlay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="شغّل الزرار العائم" android:enabled="false" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="بعد الزرين، دوس على الزرار العائم وانت جوّه اللعبة عشان تشغّل/توقف البوت. كل التشغيل محلي على الجهاز، ومفيش اتصال إنترنت."
        android:textColor="@color/textDim" android:textSize="12sp" />
</LinearLayout>
</ScrollView>

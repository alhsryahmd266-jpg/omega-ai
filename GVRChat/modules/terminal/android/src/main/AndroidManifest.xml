<?xml version="1.0" encoding="utf-8"?>
<!--
  A library module's manifest gets MERGED into the app's generated manifest
  by the Android Gradle Plugin at every build, unlike the top-level android/
  folder (wiped and regenerated from scratch on every prebuild), so this file
  is checked into the repo and always applies.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="expo.modules.terminal.GvrJobService"
            android:exported="false"
            android:stopWithTask="true" />
            <service
            android:name="expo.modules.terminal.GvrAccessibilityService"
            android:exported="true"
            android:label="GVR Agent"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gvr_accessibility" />
        </service>
    </application>
</manifest>

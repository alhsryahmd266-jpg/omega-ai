<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sight" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg0</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:colorAccent">@color/cyan</item>
    </style>

    <style name="Theme.Sight.Transparent" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
